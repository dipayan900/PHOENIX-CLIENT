{
  "schemaVersion": 1,
  "id": "brutal_xd_distant_terrain",
  "version": "${version}",
  "name": "Brutal_XD Distant Terrain",
  "description": "An Android-first distant-terrain research mod with a persistent explored-terrain cache.",
  "authors": ["Brutal_XD aka DIPAYAN"],
  "contact": {
    "sources": "https://github.com/dipayan900/PHOENIX-CLIENT"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.brutalxd.distantterrain.BrutalDistantTerrainClient"
    ],
    "sodium:config_api_user": [
      "dev.brutalxd.distantterrain.TerrainSodiumConfig"
    ]
  },
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "sodium": ">=0.8.0"
  }
